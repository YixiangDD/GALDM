__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Raw TCGA data — not shipped; see the Data section of the README
/data/

# Model weights and checkpoints (regenerated by training)
/checkpoints/
*.pt
*.pth

# The preprocessed cache IS shipped: it is what reproduces the published numbers exactly.
# Only the five protocol seeds are tracked; anything else is a local artefact.
/data_pipeline/processed/*
!/data_pipeline/processed/*_seed42.npz
!/data_pipeline/processed/*_seed42_priors.pkl
!/data_pipeline/processed/*_seed42_meta.json
!/data_pipeline/processed/*_seed123.npz
!/data_pipeline/processed/*_seed123_priors.pkl
!/data_pipeline/processed/*_seed123_meta.json
!/data_pipeline/processed/*_seed456.npz
!/data_pipeline/processed/*_seed456_priors.pkl
!/data_pipeline/processed/*_seed456_meta.json
!/data_pipeline/processed/*_seed789.npz
!/data_pipeline/processed/*_seed789_priors.pkl
!/data_pipeline/processed/*_seed789_meta.json
!/data_pipeline/processed/*_seed1024.npz
!/data_pipeline/processed/*_seed1024_priors.pkl
!/data_pipeline/processed/*_seed1024_meta.json

# Third-party prior files fetched by scripts/fetch_priors.py
/bio_priors/cache/trrust_human.tsv
/bio_priors/cache/mirtarbase*.xlsx
/bio_priors/cache/ensembl2symbol.json

# Run logs and large generated tables
*.log
/results/generated_*.xlsx

# Rendered figures are regenerated by paper_figures/. The numeric dumps behind the
# two figures that need generated samples are tracked, so those redraw without a GPU.
/results/figures/*
!/results/figures/CESC/
/results/figures/CESC/*
!/results/figures/CESC/_corr_mats_CESC.json
!/results/figures/CESC/_rv_mantel_CESC.json
!/results/figures/CESC/_umap_coords_CESC.json
!/results/*.json

.DS_Store
.idea/
.vscode/
